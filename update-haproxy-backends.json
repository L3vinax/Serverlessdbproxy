{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "7667096917683529126"
    },
    "description": "Adds listener rules to an existing HAProxy load balancer and updates the HAProxy configuration on its VM."
  },
  "definitions": {
    "backendServer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "metadata": {
            "description": "Unique HAProxy server name."
          }
        },
        "address": {
          "type": "string",
          "metadata": {
            "description": "Backend server IP address or DNS name."
          }
        },
        "port": {
          "type": "int",
          "minValue": 1,
          "maxValue": 65535
        }
      }
    },
    "haproxyBackend": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "metadata": {
            "description": "Unique HAProxy backend name. Use letters, numbers, hyphens, or underscores."
          }
        },
        "frontendPort": {
          "type": "int",
          "minValue": 1,
          "maxValue": 65535
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/backendServer"
          },
          "minLength": 1
        }
      }
    }
  },
  "parameters": {
    "vmName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing HAProxy VM."
      }
    },
    "loadBalancerName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing internal load balancer."
      }
    },
    "subnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the subnet currently used by the load balancer frontend."
      }
    },
    "networkSecurityGroupName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing network security group attached to the HAProxy VM NIC."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "maxConnections": {
      "type": "int",
      "defaultValue": 10000,
      "minValue": 1
    },
    "backends": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/haproxyBackend"
      },
      "minLength": 1,
      "maxLength": 145,
      "metadata": {
        "description": "Complete desired backend list. Each backend gets its own frontend listener port."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "backendSections",
        "count": "[length(parameters('backends'))]",
        "input": "[join(concat(createArray(format('frontend {0}_frontend', parameters('backends')[copyIndex('backendSections')].name), format('    bind 0.0.0.0:{0}', parameters('backends')[copyIndex('backendSections')].frontendPort), format('    default_backend {0}', parameters('backends')[copyIndex('backendSections')].name), '', format('backend {0}', parameters('backends')[copyIndex('backendSections')].name), '    balance roundrobin', '    option tcp-check'), map(parameters('backends')[copyIndex('backendSections')].servers, lambda('server', format('    server {0} {1}:{2} check inter 5s fall 3 rise 2', lambdaVariables('server').name, lambdaVariables('server').address, lambdaVariables('server').port)))), '\n')]"
      }
    ],
    "frontendName": "sql-frontend",
    "backendPoolName": "haproxy-backend",
    "probeName": "haproxy-health",
    "globalAndDefaultsConfig": "[join(createArray('global', '    log /dev/log local0', '    log /dev/log local1 notice', '    user haproxy', '    group haproxy', '    daemon', format('    maxconn {0}', parameters('maxConnections')), '', 'defaults', '    log global', '    mode tcp', '    option tcplog', '    option dontlognull', '    timeout connect 10s', '    timeout client 1h', '    timeout server 1h'), '\n')]",
    "healthConfig": "[join(createArray('listen health', '    bind 0.0.0.0:8404', '    mode http', '    monitor-uri /health'), '\n')]",
    "haproxyConfig": "[format('{0}\n\n{1}\n\n{2}\n', variables('globalAndDefaultsConfig'), join(variables('backendSections'), '\n\n'), variables('healthConfig'))]",
    "encodedHaproxyConfig": "[base64(variables('haproxyConfig'))]"
  },
  "resources": {
    "loadBalancer": {
      "type": "Microsoft.Network/loadBalancers",
      "apiVersion": "2024-05-01",
      "name": "[parameters('loadBalancerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "copy": [
          {
            "name": "loadBalancingRules",
            "count": "[length(parameters('backends'))]",
            "input": {
              "name": "[format('{0}-forwarding', parameters('backends')[copyIndex('loadBalancingRules')].name)]",
              "properties": {
                "protocol": "Tcp",
                "frontendPort": "[parameters('backends')[copyIndex('loadBalancingRules')].frontendPort]",
                "backendPort": "[parameters('backends')[copyIndex('loadBalancingRules')].frontendPort]",
                "enableFloatingIP": false,
                "enableTcpReset": true,
                "idleTimeoutInMinutes": 30,
                "disableOutboundSnat": true,
                "frontendIPConfiguration": {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', parameters('loadBalancerName'), variables('frontendName'))]"
                },
                "backendAddressPool": {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancerName'), variables('backendPoolName'))]"
                },
                "probe": {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/probes', parameters('loadBalancerName'), variables('probeName'))]"
                }
              }
            }
          }
        ],
        "frontendIPConfigurations": [
          {
            "name": "[variables('frontendName')]",
            "properties": {
              "subnet": {
                "id": "[parameters('subnetResourceId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "privateIPAddressVersion": "IPv4"
            }
          }
        ],
        "backendAddressPools": [
          {
            "name": "[variables('backendPoolName')]"
          }
        ],
        "probes": [
          {
            "name": "[variables('probeName')]",
            "properties": {
              "protocol": "Http",
              "port": 8404,
              "requestPath": "/health",
              "intervalInSeconds": 5,
              "numberOfProbes": 2
            }
          }
        ]
      }
    },
    "networkSecurityGroup": {
      "existing": true,
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[parameters('networkSecurityGroupName')]"
    },
    "securityRules": {
      "copy": {
        "name": "securityRules",
        "count": "[length(parameters('backends'))]"
      },
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', parameters('networkSecurityGroupName'), format('Allow-PrivateLink-{0}', parameters('backends')[copyIndex()].name))]",
      "properties": {
        "priority": "[add(200, copyIndex())]",
        "direction": "Inbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourcePortRange": "*",
        "destinationPortRange": "[string(parameters('backends')[copyIndex()].frontendPort)]",
        "sourceAddressPrefix": "VirtualNetwork",
        "destinationAddressPrefix": "*"
      }
    },
    "vm": {
      "existing": true,
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[parameters('vmName')]"
    },
    "updateHaproxyConfig": {
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2024-07-01",
      "name": "[format('{0}/{1}', parameters('vmName'), 'update-haproxy-backends')]",
      "location": "[parameters('location')]",
      "properties": {
        "source": {
          "script": "[format('set -euo pipefail\r\n\r\nnew_config=$(mktemp)\r\nbackup_config=$(mktemp)\r\ntrap ''rm -f \"$new_config\" \"$backup_config\"'' EXIT\r\n\r\nprintf ''%s'' ''{0}'' | base64 --decode > \"$new_config\"\r\nhaproxy -c -f \"$new_config\"\r\n\r\ncp /etc/haproxy/haproxy.cfg \"$backup_config\"\r\ninstall -o root -g root -m 0644 \"$new_config\" /etc/haproxy/haproxy.cfg\r\n\r\nif ! systemctl reload haproxy; then\r\n    install -o root -g root -m 0644 \"$backup_config\" /etc/haproxy/haproxy.cfg\r\n    systemctl restart haproxy\r\n    exit 1\r\nfi\r\n  ', variables('encodedHaproxyConfig'))]"
        },
        "timeoutInSeconds": 300,
        "asyncExecution": false,
        "treatFailureAsDeploymentFailure": true
      },
      "dependsOn": [
        "loadBalancer",
        "securityRules"
      ]
    }
  },
  "outputs": {
    "configuredBackends": {
      "type": "array",
      "copy": {
        "count": "[length(parameters('backends'))]",
        "input": {
          "name": "[parameters('backends')[copyIndex()].name]",
          "frontendPort": "[parameters('backends')[copyIndex()].frontendPort]",
          "servers": "[length(parameters('backends')[copyIndex()].servers)]"
        }
      }
    }
  }
}
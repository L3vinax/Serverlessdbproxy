            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'nsg'), '2025-04-01').outputs.id.value]"
          },
          "backendPoolId": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'load-balancer'), '2025-04-01').outputs.backendPoolId.value]"

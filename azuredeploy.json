    "description": "Deploys HAProxy behind an internal Standard Load Balancer and Private Link Service for Databricks Serverless access to on-premises SQL Server."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "prefix": {
      "type": "string",
      "defaultValue": "dbx-sqlproxy"
    },
    "subnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "Existing subnet resource ID. Private Link service network policies must be disabled."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureadmin"
    },
    "sshPublicKey": {
      "type": "securestring"
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5"
    },
    "frontendPort": {
      "type": "int",
      "defaultValue": 1433,
      "minValue": 1,
      "maxValue": 65535
    },
    "sqlServerAddress": {
      "type": "string"
    },
    "sqlServerPort": {
      "type": "int",
      "defaultValue": 1433,
      "minValue": 1,
      "maxValue": 65535
    },
    "maxConnections": {
      "type": "int",
      "defaultValue": 10000
    },
    "visibilitySubscriptionIds": {
      "type": "array",
      "defaultValue": []
    },
    "autoApprovalSubscriptionIds": {
      "type": "array",
      "defaultValue": []
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },

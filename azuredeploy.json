            },
            "region": {
              "type": "string",
              "metadata": {
                "description": "Azure region in Databricks region format (e.g. westus2). Must match the workspace region."
              }
            },
            "nccName": {
              "type": "string",
              "metadata": {
                "description": "Name of the network connectivity configuration. Must match ^[0-9a-zA-Z-_]{3,30}$."
              }
            },
            "privateLinkServiceResourceId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Private Link Service to create a private endpoint to."
              }
            },
            "privateLinkServiceDomainNames": {
              "type": "array",
              "metadata": {
                "description": "Domain name(s) clients use to reach the Private Link Service, e.g. the on-prem SQL Server FQDN."
              }
            },
            "identityResourceId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of a user-assigned managed identity that is an Account Admin in the Databricks account."
              }
            },
            "forceUpdateTag": {
              "type": "string",
              "defaultValue": "[utcNow()]",
              "metadata": {
                "description": "Change to force the script to re-run on a redeploy (defaults to current time)."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Resources/deploymentScripts",
              "apiVersion": "2023-08-01",
              "name": "configure-databricks-ncc",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "AzureCLI",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('identityResourceId'))]": {}
                }
              },
              "properties": {
                "azCliVersion": "2.63.0",
                "forceUpdateTag": "[parameters('forceUpdateTag')]",
                "timeout": "PT30M",
                "retentionInterval": "P1D",
                "cleanupPreference": "OnSuccess",
                "environmentVariables": [
                  {
                    "name": "ACCOUNT_HOST",
                    "value": "[parameters('accountConsoleUrl')]"
                  },
                  {
                    "name": "ACCOUNT_ID",
                    "value": "[parameters('databricksAccountId')]"
                  },
                  {
                    "name": "WORKSPACE_ID",
                    "value": "[parameters('databricksWorkspaceId')]"
                  },
                  {
                    "name": "REGION",
                    "value": "[parameters('region')]"
                  },
                  {
                    "name": "NCC_NAME",
                    "value": "[parameters('nccName')]"
                  },
                  {
                    "name": "PLS_RESOURCE_ID",
                    "value": "[parameters('privateLinkServiceResourceId')]"
                  },
                  {
                    "name": "DOMAIN_NAMES_JSON",
                    "value": "[string(parameters('privateLinkServiceDomainNames'))]"
                  }
                ],
                "scriptContent": "      set -euo pipefail\n\n      TOKEN=$(az account get-access-token --resource 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d --query accessToken -o tsv)\n      BASE=\"$ACCOUNT_HOST/api/2.0/accounts/$ACCOUNT_ID\"\n      AUTH_HEADER=\"Authorization: Bearer $TOKEN\"\n\n      # Reuse an existing NCC with the same name instead of creating a duplicate on every redeploy.\n      EXISTING_NCC_JSON=$(curl -sf -H \"$AUTH_HEADER\" \"$BASE/network-connectivity-configs\")\n      NCC_ID=$(echo \"$EXISTING_NCC_JSON\" | python3 -c 'import json,os,sys; items=json.load(sys.stdin).get(\"items\",[]); m=[i for i in items if i[\"name\"]==os.environ[\"NCC_NAME\"]]; print(m[0][\"network_connectivity_config_id\"] if m else \"\")')\n\n      if [ -z \"$NCC_ID\" ]; then\n        echo \"Creating network connectivity configuration '$NCC_NAME' in $REGION...\"\n        NCC_BODY=$(python3 -c 'import json,os; print(json.dumps({\"name\": os.environ[\"NCC_NAME\"], \"region\": os.environ[\"REGION\"]}))')\n        NCC_JSON=$(curl -sf -X POST \"$BASE/network-connectivity-configs\" -H \"$AUTH_HEADER\" -H \"Content-Type: application/json\" -d \"$NCC_BODY\")\n        NCC_ID=$(echo \"$NCC_JSON\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"network_connectivity_config_id\"])')\n        echo \"Created NCC $NCC_ID\"\n      else\n        echo \"Reusing existing NCC $NCC_ID\"\n      fi\n      export NCC_ID\n\n      echo \"Binding NCC to workspace $WORKSPACE_ID...\"\n      BIND_BODY=$(python3 -c 'import json,os; print(json.dumps({\"network_connectivity_config_id\": os.environ[\"NCC_ID\"]}))')\n      curl -sf -X PATCH \"$BASE/workspaces/$WORKSPACE_ID\" -H \"$AUTH_HEADER\" -H \"Content-Type: application/json\" -d \"$BIND_BODY\" > /dev/null\n\n      # Reuse (and update domain_names on) an existing rule for this resource_id instead of creating a duplicate private endpoint.\n      EXISTING_RULES_JSON=$(curl -sf -H \"$AUTH_HEADER\" \"$BASE/network-connectivity-configs/$NCC_ID/private-endpoint-rules\")\n      RULE_ID=$(echo \"$EXISTING_RULES_JSON\" | python3 -c 'import json,os,sys; items=json.load(sys.stdin).get(\"items\",[]); m=[i for i in items if i.get(\"resource_id\")==os.environ[\"PLS_RESOURCE_ID\"] and not i.get(\"deactivated\")]; print(m[0][\"rule_id\"] if m else \"\")')\n\n      if [ -z \"$RULE_ID\" ]; then\n        echo \"Creating private endpoint rule to $PLS_RESOURCE_ID...\"\n        RULE_BODY=$(python3 -c 'import json,os; print(json.dumps({\"resource_id\": os.environ[\"PLS_RESOURCE_ID\"], \"domain_names\": json.loads(os.environ[\"DOMAIN_NAMES_JSON\"])}))')\n        RULE_JSON=$(curl -sf -X POST \"$BASE/network-connectivity-configs/$NCC_ID/private-endpoint-rules\" -H \"$AUTH_HEADER\" -H \"Content-Type: application/json\" -d \"$RULE_BODY\")\n      else\n        echo \"Updating domain_names on existing private endpoint rule $RULE_ID...\"\n        RULE_BODY=$(python3 -c 'import json,os; print(json.dumps({\"domain_names\": json.loads(os.environ[\"DOMAIN_NAMES_JSON\"])}))')\n        RULE_JSON=$(curl -sf -X PATCH \"$BASE/network-connectivity-configs/$NCC_ID/private-endpoint-rules/$RULE_ID?update_mask=domain_names\" -H \"$AUTH_HEADER\" -H \"Content-Type: application/json\" -d \"$RULE_BODY\")\n      fi\n      RULE_ID=$(echo \"$RULE_JSON\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"rule_id\"])')\n      CONNECTION_STATE=$(echo \"$RULE_JSON\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"connection_state\"])')\n      export RULE_ID CONNECTION_STATE\n      echo \"Private endpoint rule $RULE_ID ready (connection_state=$CONNECTION_STATE)\"\n\n      python3 -c 'import json,os; print(json.dumps({\"networkConnectivityConfigId\": os.environ[\"NCC_ID\"], \"privateEndpointRuleId\": os.environ[\"RULE_ID\"], \"connectionState\": os.environ[\"CONNECTION_STATE\"]}))' > \"$AZ_SCRIPTS_OUTPUT_PATH\"\n    "
              }
            }
          ],
          "outputs": {
            "networkConnectivityConfigId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'configure-databricks-ncc'), '2023-08-01').outputs.networkConnectivityConfigId]"
            },
            "privateEndpointRuleId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'configure-databricks-ncc'), '2023-08-01').outputs.privateEndpointRuleId]"
            },
            "connectionState": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'configure-databricks-ncc'), '2023-08-01').outputs.connectionState]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'private-link-service')]"
      ]
    }
  ],
  "outputs": {
    "privateLinkServiceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'private-link-service'), '2025-04-01').outputs.id.value]"
    },
    "privateLinkServiceAlias": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'private-link-service'), '2025-04-01').outputs.alias.value]"
    },
    "haproxyVmName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'haproxy-vm'), '2025-04-01').outputs.vmName.value]"
    },
    "frontendPort": {
      "type": "int",
      "value": "[parameters('frontendPort')]"
    },
    "networkConnectivityConfigId": {
      "type": "string",
      "value": "[coalesce(tryGet(if(parameters('deployDatabricksNcc'), reference(resourceId('Microsoft.Resources/deployments', 'databricks-ncc'), '2025-04-01'), null()), 'outputs', 'networkConnectivityConfigId', 'value'), '')]"
    }
  }
}
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "17185413892809554995"
    },
    "description": "Deploys HAProxy behind an internal Standard Load Balancer and Private Link Service for Databricks Serverless access to on-premises SQL Server."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "prefix": {
      "type": "string",
      "defaultValue": "dbx-sqlproxy"
    },
    "subnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "Existing subnet resource ID. Private Link service network policies must be disabled."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureadmin"
    },
    "sshPublicKey": {
      "type": "securestring"
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5"
    },
    "frontendPort": {
      "type": "int",
      "defaultValue": 1433,
      "minValue": 1,
      "maxValue": 65535
    },
    "sqlServerAddress": {
      "type": "string"
    },
    "sqlServerPort": {
      "type": "int",
      "defaultValue": 1433,
      "minValue": 1,
      "maxValue": 65535
    },
    "maxConnections": {
      "type": "int",
      "defaultValue": 10000
    },
    "osType": {
      "type": "string",
      "defaultValue": "Ubuntu",
      "allowedValues": [
        "Ubuntu",
        "RHEL"
      ],
      "metadata": {
        "description": "Linux distribution for the HAProxy VM."
      }
    },
    "visibilitySubscriptionIds": {
      "type": "array",
      "defaultValue": []
    },
    "autoApprovalSubscriptionIds": {
      "type": "array",
      "defaultValue": []
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "deployDatabricksNcc": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set true to also configure a Databricks NCC and private endpoint to the Private Link Service created above."
      }
    },
    "databricksAccountConsoleUrl": {
      "type": "string",
      "defaultValue": "https://accounts.azuredatabricks.net"
    },
    "databricksAccountId": {
      "type": "string",
      "defaultValue": ""
    },
    "databricksWorkspaceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Numeric Databricks workspace ID (not the ARM resource ID)."
      }
    },
    "databricksRegion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure region in Databricks region format (e.g. westus2). Required if deployDatabricksNcc is true."
      }
    },
    "privateLinkServiceDomainNames": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Domain name(s) clients use to reach the Private Link Service, e.g. the on-prem SQL Server FQDN."
      }
    },
    "databricksNccIdentityResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of a user-assigned managed identity that is an Account Admin in the Databricks account. Required if deployDatabricksNcc is true."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "nsg",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('{0}-nsg', parameters('prefix'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          },
          "frontendPort": {
            "value": "[parameters('frontendPort')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "7059808033665160147"
            }
          },
          "parameters": {
            "name": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            },
            "frontendPort": {
              "type": "int"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2024-05-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "securityRules": [
                  {
                    "name": "Allow-PrivateLink-Traffic",
                    "properties": {
                      "priority": 100,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourcePortRange": "*",
                      "destinationPortRange": "[string(parameters('frontendPort'))]",
                      "sourceAddressPrefix": "VirtualNetwork",
                      "destinationAddressPrefix": "*"
                    }
                  },
                  {
                    "name": "Allow-AzureLoadBalancer-Probe",
                    "properties": {
                      "priority": 110,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourcePortRange": "*",
                      "destinationPortRange": "8404",
                      "sourceAddressPrefix": "AzureLoadBalancer",
                      "destinationAddressPrefix": "*"
                    }
                  }
                ]
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('name'))]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "load-balancer",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('{0}-ilb', parameters('prefix'))]"
          },

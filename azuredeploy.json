            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            },
            "subnetResourceId": {
              "type": "string"
            },
            "frontendPort": {
              "type": "int"
            }
          },
          "variables": {

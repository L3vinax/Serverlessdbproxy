          },
          "variables": {
            "nicName": "[format('{0}-nic', parameters('name'))]",
            "cloudInit": "[format('#cloud-config\npackage_update: true\npackages:\n  - haproxy\n\nwrite_files:\n  - path: /etc/haproxy/haproxy.cfg\n    owner: root:root\n    permissions: ''0644''\n    content: |\n      global\n          log /dev/log local0\n          log /dev/log local1 notice\n          user haproxy\n          group haproxy\n          daemon\n          maxconn {0}\n\n      defaults\n          log global\n          mode tcp\n          option tcplog\n          option dontlognull\n          timeout connect 10s\n          timeout client 1h\n          timeout server 1h\n\n      frontend sql_frontend\n          bind 0.0.0.0:{1}\n          default_backend sql_backend\n\n      backend sql_backend\n          option tcp-check\n          server sql01 {2}:{3} check inter 5s fall 3 rise 2\n\n      listen health\n          bind 0.0.0.0:8404\n          mode http\n          monitor-uri /health\n\nruncmd:\n  - haproxy -c -f /etc/haproxy/haproxy.cfg\n  - systemctl enable haproxy\n  - systemctl restart haproxy\n', parameters('maxConnections'), parameters('frontendPort'), parameters('sqlServerAddress'), parameters('sqlServerPort'))]"
          },
